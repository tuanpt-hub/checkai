{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": [
    "bom1"
  ],
  "outputDirectory": "public",
  "cleanUrls": true,
  "functions": {
    "api/probe.js": {
      "maxDuration": 120
    },
    "api/claude.js": {
      "maxDuration": 120
    },
    "api/scan.js": {
      "maxDuration": 120
    },
    "api/intake.js": {
      "maxDuration": 60
    },
    "api/hc.js": {
      "maxDuration": 120,
      "includeFiles": "{public/site/report.html,public/site/assets/symbol.png,node_modules/@expo-google-fonts/nunito/800ExtraBold/Nunito_800ExtraBold.ttf,node_modules/@expo-google-fonts/nunito/400Regular/Nunito_400Regular.ttf}"
    },
    "api/leads.js": {
      "maxDuration": 30
    },
    "api/users.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/login",
      "destination": "/api/me?op=login"
    },
    {
      "source": "/api/logout",
      "destination": "/api/me?op=logout"
    },
    {
      "source": "/api/entity",
      "destination": "/api/scan?op=entity"
    },
    {
      "source": "/api/verify-claim",
      "destination": "/api/scan?op=claim"
    },
    {
      "source": "/api/intake-ai",
      "destination": "/api/intake?op=ai"
    },
    {
      "source": "/api/intake-submissions",
      "destination": "/api/intake-links?op=subs"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "brand.ai.vn"
        }
      ],
      "destination": "/site/home"
    },
    {
      "source": "/kiem-tra",
      "has": [
        {
          "type": "host",
          "value": "brand.ai.vn"
        }
      ],
      "destination": "/site/kiem-tra"
    },
    {
      "source": "/r/:token",
      "has": [
        {
          "type": "host",
          "value": "brand.ai.vn"
        }
      ],
      "destination": "/api/hc?op=page&t=:token"
    },
    {
      "source": "/robots.txt",
      "has": [
        {
          "type": "host",
          "value": "brand.ai.vn"
        }
      ],
      "destination": "/site/robots.txt"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "brand.ai.vn"
        }
      ],
      "destination": "/site/sitemap.xml"
    },
    {
      "source": "/llms.txt",
      "has": [
        {
          "type": "host",
          "value": "brand.ai.vn"
        }
      ],
      "destination": "/site/llms.txt"
    },
    {
      "source": "/ho-so",
      "destination": "/intake"
    },
    {
      "source": "/",
      "destination": "/app"
    },
    {
      "source": "/robots.txt",
      "destination": "/app-robots.txt"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ],
      "missing": [
        {
          "type": "host",
          "value": "brand.ai.vn"
        }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "brand.ai.vn"
        }
      ],
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/r/(.*)",
      "has": [
        {
          "type": "host",
          "value": "brand.ai.vn"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/(ho-so|intake)",
      "has": [
        {
          "type": "host",
          "value": "brand.ai.vn"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/kiem-tra",
      "has": [
        {
          "type": "host",
          "value": "brand.ai.vn"
        }
      ],
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/site/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/(dashboard\\.css|sov\\.js|evidence\\.js|pillars\\.js|cost\\.js|api-response\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/site/(site\\.css|site\\.js)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.brand.ai.vn"
        }
      ],
      "destination": "https://brand.ai.vn/:path*",
      "permanent": true
    }
  ]
}
